                        <input type="file" id="cust-receipt" accept="image/*" onchange="handleReceiptSelect(this)" class="block w-full text-xs text-white/80 cursor-pointer file:mr-3 file:py-2 file:px-3.5 file:rounded-xl file:border file:border-white/40 file:text-xs file:font-semibold file:bg-white/20 file:text-white hover:file:bg-white/30">
                        <div id="receipt-preview-box" class="hidden pt-2.5 border-t border-white/15 flex items-center justify-between gap-2 text-left">
                            <div class="flex items-center gap-2.5 overflow-hidden">
                                <img id="receipt-thumb" src="" alt="Chek" class="w-11 h-11 rounded-xl object-cover border border-white/30 flex-shrink-0">
                                <div class="overflow-hidden">
                                    <p id="receipt-filename" class="text-xs font-bold text-emerald-300 truncate">chek.jpg</p>
                                    <p class="text-[10px] text-muted-white">Chek muvaffaqiyatli biriktirildi</p>
                                </div>
