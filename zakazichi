<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Telegram Premium & Stars — Liquid Glass</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Telegram WebApp SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --glass-bg: rgba(255, 255, 255, 0.14);
            --glass-card-bg: rgba(255, 255, 255, 0.12);
            --glass-border: rgba(255, 255, 255, 0.28);
            --glass-highlight-top: rgba(255, 255, 255, 0.58);
            --glass-highlight-bottom: rgba(0, 0, 0, 0.28);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #241f1b;
            background-image: 
                radial-gradient(ellipse at 18% 12%, rgba(168, 152, 138, 0.52) 0%, transparent 52%),
                radial-gradient(ellipse at 85% 24%, rgba(110, 98, 87, 0.65) 0%, transparent 56%),
                radial-gradient(ellipse at 45% 58%, rgba(140, 127, 115, 0.45) 0%, transparent 60%),
                radial-gradient(ellipse at 82% 88%, rgba(61, 53, 46, 0.85) 0%, transparent 55%),
                linear-gradient(145deg, #3d352e 0%, #6e6257 38%, #241f1b 74%, #8c7f73 100%);
            background-attachment: fixed;
            color: #ffffff;
            min-height: 100vh;
            overflow-x: hidden;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.22);
        }

        /* Ipaksimon organik yorug'lik to'lqinlari (orqa fonda) */
        .silk-wave-container {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            overflow: hidden;
        }

        .silk-ribbon-1 {
            position: absolute;
            top: -15%;
            left: -20%;
            width: 140%;
            height: 65%;
            background: linear-gradient(125deg, rgba(255, 248, 240, 0.24) 0%, rgba(165, 150, 136, 0.08) 45%, rgba(255, 255, 255, 0.18) 100%);
            border-radius: 48% 52% 65% 35% / 40% 60% 40% 60%;
            filter: blur(28px);
            transform: rotate(-12deg);
        }

        .silk-ribbon-2 {
            position: absolute;
            top: 32%;
            right: -25%;
            width: 135%;
            height: 55%;
            background: linear-gradient(210deg, rgba(235, 224, 213, 0.22) 0%, rgba(45, 38, 33, 0.45) 55%, rgba(210, 196, 182, 0.2) 100%);
            border-radius: 60% 40% 35% 65% / 55% 45% 55% 45%;
            filter: blur(24px);
            transform: rotate(16deg);
        }

        .silk-ribbon-3 {
            position: absolute;
            bottom: -18%;
            left: -15%;
            width: 130%;
            height: 50%;
            background: radial-gradient(circle at 40% 40%, rgba(225, 212, 198, 0.25), rgba(36, 31, 27, 0.6) 70%);
            border-radius: 50%;
            filter: blur(32px);
        }

        /* iOS 26 Liquid Glass (Suyuq Shisha) Vidjet Effekti */
        .liquid-glass {
            background: var(--glass-bg);
            backdrop-filter: blur(24px) saturate(145%);
            -webkit-backdrop-filter: blur(24px) saturate(145%);
            border-radius: 26px;
            border: 1px solid var(--glass-border);
            box-shadow: 
                inset 0 1.5px 1.5px var(--glass-highlight-top),
                inset 0 -1.5px 2px var(--glass-highlight-bottom),
                inset 1px 0 1.5px rgba(255, 255, 255, 0.28),
                0 14px 34px rgba(15, 12, 10, 0.34);
            position: relative;
        }

        .liquid-glass-card {
            background: var(--glass-card-bg);
            backdrop-filter: blur(22px) saturate(140%);
            -webkit-backdrop-filter: blur(22px) saturate(140%);
            border-radius: 24px;
            border: 1px solid rgba(255, 255, 255, 0.26);
            box-shadow: 
                inset 0 1.5px 1.5px rgba(255, 255, 255, 0.52),
                inset 0 -1.5px 2px rgba(0, 0, 0, 0.24),
                0 10px 26px rgba(15, 12, 10, 0.28);
            transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1), background 0.18s ease, box-shadow 0.18s ease;
        }

        .liquid-glass-card:hover {
            background: rgba(255, 255, 255, 0.17);
            box-shadow: 
                inset 0 1.5px 2px rgba(255, 255, 255, 0.65),
                inset 0 -1.5px 2px rgba(0, 0, 0, 0.25),
                0 14px 30px rgba(15, 12, 10, 0.35);
        }

        .liquid-glass-card:active {
            transform: scale(0.985);
        }

        .liquid-glass-header {
            background: rgba(48, 41, 36, 0.42);
            backdrop-filter: blur(26px) saturate(150%);
            -webkit-backdrop-filter: blur(26px) saturate(150%);
            border-bottom: 1px solid rgba(255, 255, 255, 0.24);
            box-shadow: 
                inset 0 -1px 1px rgba(255, 255, 255, 0.18),
                0 8px 24px rgba(0, 0, 0, 0.25);
        }

        .liquid-pill {
            background: rgba(255, 255, 255, 0.16);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.32);
            box-shadow: 
                inset 0 1px 1px rgba(255, 255, 255, 0.55),
                inset 0 -1px 1px rgba(0, 0, 0, 0.22);
            transition: all 0.16s ease;
        }

        .liquid-pill:hover {
            background: rgba(255, 255, 255, 0.26);
        }

        .liquid-pill:active {
            transform: scale(0.96);
        }

        .liquid-btn-primary {
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.34) 0%, rgba(255, 255, 255, 0.16) 100%);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.45);
            box-shadow: 
                inset 0 1.5px 1.5px rgba(255, 255, 255, 0.72),
                inset 0 -1.5px 2px rgba(0, 0, 0, 0.25),
                0 6px 18px rgba(0, 0, 0, 0.24);
            color: #ffffff;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
            transition: all 0.18s ease;
        }

        .liquid-btn-primary:hover {
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.44) 0%, rgba(255, 255, 255, 0.22) 100%);
            box-shadow: 
                inset 0 1.5px 2px rgba(255, 255, 255, 0.85),
                inset 0 -1.5px 2px rgba(0, 0, 0, 0.25),
                0 8px 22px rgba(0, 0, 0, 0.3);
        }

        .liquid-btn-primary:active {
            transform: scale(0.98);
        }

        .liquid-btn-emerald {
            background: linear-gradient(180deg, rgba(52, 211, 153, 0.55) 0%, rgba(16, 185, 129, 0.38) 100%);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(167, 243, 208, 0.55);
            box-shadow: 
                inset 0 1.5px 1.5px rgba(255, 255, 255, 0.65),
                inset 0 -1.5px 2px rgba(6, 78, 59, 0.35),
                0 8px 22px rgba(6, 78, 59, 0.35);
            color: #ffffff;
            transition: all 0.18s ease;
        }

        .liquid-btn-emerald:hover {
            background: linear-gradient(180deg, rgba(52, 211, 153, 0.68) 0%, rgba(16, 185, 129, 0.48) 100%);
        }

        .liquid-input {
            background: rgba(24, 20, 17, 0.34);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.24);
            box-shadow: 
                inset 0 1.5px 3px rgba(0, 0, 0, 0.32),
                0 1px 0 rgba(255, 255, 255, 0.2);
            color: #ffffff;
            transition: all 0.18s ease;
        }

        .liquid-input::placeholder {
            color: rgba(255, 255, 255, 0.48);
        }

        .liquid-input:focus {
            outline: none;
            background: rgba(24, 20, 17, 0.46);
            border-color: rgba(255, 255, 255, 0.58);
            box-shadow: 
                inset 0 1.5px 3px rgba(0, 0, 0, 0.35),
                0 0 0 3px rgba(255, 255, 255, 0.12);
        }

        .liquid-modal {
            background: rgba(54, 47, 41, 0.68);
            backdrop-filter: blur(32px) saturate(160%);
            -webkit-backdrop-filter: blur(32px) saturate(160%);
            border-radius: 28px;
            border: 1px solid rgba(255, 255, 255, 0.34);
            box-shadow: 
                inset 0 1.5px 1.5px rgba(255, 255, 255, 0.6),
                inset 0 -1.5px 2px rgba(0, 0, 0, 0.35),
                0 24px 50px rgba(0, 0, 0, 0.55);
        }

        .text-soft-white {
            color: rgba(255, 255, 255, 0.82);
        }

        .text-muted-white {
            color: rgba(255, 255, 255, 0.62);
        }

        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.28); border-radius: 9999px; }
    </style>
</head>
<body class="antialiased pb-16 selection:bg-white/30 selection:text-white">

    <!-- Orqa fondagi suyuq ipaksimon yorug'lik to'lqinlari -->
    <div class="silk-wave-container" aria-hidden="true">
        <div class="silk-ribbon-1"></div>
        <div class="silk-ribbon-2"></div>
        <div class="silk-ribbon-3"></div>
    </div>

    <!-- Bildirishnoma (Toast Notification) -->
    <div id="toast-container" class="fixed top-16 left-1/2 -translate-x-1/2 z-[100] w-full max-w-xs px-4 pointer-events-none flex flex-col gap-2"></div>

    <!-- Yuqori navigatsiya paneli -->
    <header class="sticky top-0 z-40 liquid-glass-header px-4 py-3 flex items-center justify-between">
        <div class="flex items-center space-x-2.5">
            <div class="w-9 h-9 rounded-2xl liquid-pill flex items-center justify-center">
                <span class="text-white font-bold text-base drop-shadow">⭐</span>
            </div>
            <div>
                <h1 class="text-sm font-extrabold tracking-tight text-white leading-tight">Premium & Stars</h1>
                <p class="text-[10px] font-medium text-emerald-300 flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_6px_#34d399]"></span> Bot ulangan (Jonli)
                </p>
            </div>
        </div>
        <div class="flex items-center space-x-1 bg-black/25 p-1 rounded-2xl border border-white/15 backdrop-blur-md">
            <button onclick="switchTab('user')" id="nav-user" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white/25 text-white shadow-[inset_0_1px_1px_rgba(255,255,255,0.5)] transition-all">Mijoz</button>
            <button onclick="switchTab('admin')" id="nav-admin" class="px-3.5 py-1.5 rounded-xl text-xs font-medium text-white/70 hover:text-white transition-all">Admin</button>
        </div>
    </header>

    <main class="relative z-10 max-w-md mx-auto px-4 mt-5">
        <!-- ================= MIJOZ (USER) QISMI ================= -->
        <div id="view-user" class="space-y-6">
            
            <!-- Telegram Stars Kalkulyatori (Liquid Glass Vidjet) -->
            <div class="liquid-glass p-5 overflow-hidden">
                <div class="flex items-center justify-between mb-1">
                    <h2 class="text-base font-bold text-white flex items-center gap-1.5">
                        <span>⭐</span> Telegram Stars
                    </h2>
                    <span class="text-[11px] text-white font-semibold liquid-pill px-2.5 py-1 rounded-full">1 Star = 240 so'm</span>
                </div>
                <p class="text-xs text-muted-white mb-4">Kerakli yulduzchalar sonini kiriting (Minimal: 50 ta)</p>
                
                <!-- Tezkor tanlash tugmalari -->
                <div class="grid grid-cols-4 gap-2 mb-3.5">
                    <button type="button" onclick="setStarsPreset(50)" class="py-2 rounded-2xl liquid-pill text-xs font-semibold text-white">50 ⭐</button>
                    <button type="button" onclick="setStarsPreset(100)" class="py-2 rounded-2xl liquid-pill text-xs font-semibold text-white">100 ⭐</button>
                    <button type="button" onclick="setStarsPreset(250)" class="py-2 rounded-2xl liquid-pill text-xs font-semibold text-white">250 ⭐</button>
                    <button type="button" onclick="setStarsPreset(500)" class="py-2 rounded-2xl liquid-pill text-xs font-semibold text-white">500 ⭐</button>
                </div>

                <div class="space-y-3">
                    <div>
                        <label class="block text-xs font-medium text-soft-white mb-1.5">Stars miqdori:</label>
                        <input type="number" id="calc-stars" min="50" value="50" oninput="calculateStars()" class="w-full liquid-input rounded-2xl px-4 py-2.5 font-bold text-sm">
                    </div>
                    <div class="flex justify-between items-center bg-black/25 px-4 py-3.5 rounded-2xl border border-white/15 shadow-inner">
                        <span class="text-xs font-medium text-soft-white">To'lov summasi:</span>
                        <span id="calc-total" class="text-base font-extrabold text-white tracking-tight">12,000 so'm</span>
                    </div>
                    <button onclick="openStarsOrder()" class="w-full py-3.5 liquid-btn-primary font-bold text-xs rounded-2xl tracking-wide">
                        Stars Sotib Olish
                    </button>
                </div>
            </div>

            <!-- Xizmatlar Kataloki -->
            <div class="space-y-4">
                <h2 class="text-sm font-bold text-white px-1 flex items-center gap-1.5">
                    <span>💎</span> Telegram Premium Tariflari
                </h2>
                
                <!-- 1. Akauntga kirib -->
                <div class="space-y-2.5">
                    <p class="text-xs font-semibold text-soft-white px-1">📲 Akauntga kirib ❗️</p>
                    
                    <div class="liquid-glass-card p-4 flex items-center justify-between gap-3">
                        <div>
                            <h3 class="text-sm font-bold text-white">1 oylik Premium</h3>
                            <p class="text-[11px] text-muted-white">Akauntga kirish orqali ulanadi</p>
                            <p class="text-xs font-extrabold text-white mt-1.5">50,000 so'm</p>
                        </div>
                        <button onclick="openCustomOrder('Telegram Premium (Akauntga kirib - 1 oy)', '50,000 so\'m')" class="px-4 py-2.5 liquid-btn-primary text-xs font-semibold rounded-2xl flex-shrink-0">Sotib olish</button>
                    </div>

                    <div class="liquid-glass-card p-4 flex items-center justify-between gap-3">
                        <div>
                            <h3 class="text-sm font-bold text-white">1 yillik Premium</h3>
                            <p class="text-[11px] text-muted-white">Akauntga kirish orqali ulanadi</p>
                            <p class="text-xs font-extrabold text-white mt-1.5">285,000 so'm</p>
                        </div>
                        <button onclick="openCustomOrder('Telegram Premium (Akauntga kirib - 1 yil)', '285,000 so\'m')" class="px-4 py-2.5 liquid-btn-primary text-xs font-semibold rounded-2xl flex-shrink-0">Sotib olish</button>
                    </div>
                </div>

                <!-- 2. Sovg'a qilish orqali -->
                <div class="space-y-2.5 pt-2">
                    <p class="text-xs font-semibold text-soft-white px-1">🎁 Sovg'a qilish orqali ⬜️</p>
                    
                    <div class="liquid-glass-card p-4 flex items-center justify-between gap-3">
                        <div>
                            <h3 class="text-sm font-bold text-white">3 oylik Premium</h3>
                            <p class="text-[11px] text-muted-white">Akauntga kirmasdan sovg'a (Gift)</p>
                            <p class="text-xs font-extrabold text-white mt-1.5">185,000 so'm</p>
                        </div>
                        <button onclick="openCustomOrder('Telegram Premium (Sovg\'a - 3 oy)', '185,000 so\'m')" class="px-4 py-2.5 liquid-btn-primary text-xs font-semibold rounded-2xl flex-shrink-0">Sotib olish</button>
                    </div>

                    <div class="liquid-glass-card p-4 flex items-center justify-between gap-3">
                        <div>
                            <h3 class="text-sm font-bold text-white">6 oylik Premium</h3>
                            <p class="text-[11px] text-muted-white">Akauntga kirmasdan sovg'a (Gift)</p>
                            <p class="text-xs font-extrabold text-white mt-1.5">250,000 so'm</p>
                        </div>
                        <button onclick="openCustomOrder('Telegram Premium (Sovg\'a - 6 oy)', '250,000 so\'m')" class="px-4 py-2.5 liquid-btn-primary text-xs font-semibold rounded-2xl flex-shrink-0">Sotib olish</button>
                    </div>

                    <div class="liquid-glass-card p-4 flex items-center justify-between gap-3">
                        <div>
                            <h3 class="text-sm font-bold text-white">1 yillik Premium</h3>
                            <p class="text-[11px] text-muted-white">Akauntga kirmasdan sovg'a (Gift)</p>
                            <p class="text-xs font-extrabold text-white mt-1.5">445,000 so'm</p>
                        </div>
                        <button onclick="openCustomOrder('Telegram Premium (Sovg\'a - 1 yil)', '445,000 so\'m')" class="px-4 py-2.5 liquid-btn-primary text-xs font-semibold rounded-2xl flex-shrink-0">Sotib olish</button>
                    </div>
                </div>

                <!-- Admin qo'shgan qo'shimcha xizmatlar -->
                <div id="user-custom-services-wrapper" class="hidden space-y-2.5 pt-2">
                    <p class="text-xs font-semibold text-soft-white px-1">✨ Qo'shimcha xizmatlar</p>
                    <div id="user-services-list" class="space-y-2.5"></div>
                </div>
            </div>
        </div>

        <!-- ================= ADMIN PANEL QISMI ================= -->
        <div id="view-admin" class="hidden space-y-6">
            <!-- PIN Kirish Oynasi -->
            <div id="admin-login-box" class="liquid-glass p-6 text-center">
                <div class="w-12 h-12 liquid-pill rounded-2xl mx-auto flex items-center justify-center text-xl mb-3">🔒</div>
                <h3 class="text-base font-bold text-white mb-1">Admin Panel</h3>
                <p class="text-xs text-muted-white mb-4">Davom etish uchun 4 xonali PIN-kodni kiriting (Standart: 2026)</p>
                <div class="flex justify-center space-x-2 mb-4">
                    <input type="password" id="admin-pin-input" maxlength="4" inputmode="numeric" placeholder="••••" class="w-36 text-center liquid-input rounded-2xl px-4 py-2.5 tracking-[0.5em] text-lg font-bold">
                </div>
                <button onclick="checkAdminPin()" class="w-full py-3 liquid-btn-primary text-xs font-semibold rounded-2xl">Kirish</button>
            </div>

            <!-- Admin Boshqaruv Paneli -->
            <div id="admin-dashboard" class="hidden space-y-5">
                <div class="flex justify-between items-center liquid-glass px-4 py-3 rounded-2xl">
                    <span class="text-xs font-semibold text-emerald-300 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_6px_#34d399]"></span> Boshqaruv faol
                    </span>
                    <button onclick="lockAdmin()" class="text-xs text-red-300 hover:text-red-200 font-semibold">Chiqish</button>
                </div>

                <!-- Admin Ichki Bo'limlari -->
                <div class="grid grid-cols-4 gap-1 bg-black/25 p-1.5 rounded-2xl border border-white/15 backdrop-blur-md text-center text-[11px] font-semibold">
                    <button onclick="switchAdminTab('orders')" id="adm-tab-orders" class="py-2 rounded-xl bg-white/25 text-white shadow-[inset_0_1px_1px_rgba(255,255,255,0.5)] transition-all">Buyurtma</button>
                    <button onclick="switchAdminTab('services')" id="adm-tab-services" class="py-2 rounded-xl text-white/70 hover:text-white transition-all">Xizmatlar</button>
                    <button onclick="switchAdminTab('requisites')" id="adm-tab-requisites" class="py-2 rounded-xl text-white/70 hover:text-white transition-all">Rekvizit</button>
                    <button onclick="switchAdminTab('settings')" id="adm-tab-settings" class="py-2 rounded-xl text-white/70 hover:text-white transition-all">Sozlama</button>
                </div>

                <!-- 1. Buyurtmalar Tarixi -->
                <div id="admin-content-orders" class="space-y-3">
                    <div class="liquid-glass px-4 py-3 rounded-2xl flex items-center justify-between">
                        <span class="text-xs font-bold text-white">So'nggi buyurtmalar</span>
                        <button onclick="clearOrders()" class="text-[11px] text-red-300 hover:underline font-medium">Tozalash</button>
                    </div>
                    <div id="admin-orders-list" class="space-y-2.5"></div>
                </div>

                <!-- 2. Xizmatlar Qo'shish -->
                <div id="admin-content-services" class="hidden space-y-4">
                    <div class="liquid-glass p-4 space-y-3">
                        <h3 class="text-xs font-bold text-white uppercase tracking-wider">Yangi Xizmat Qo'shish</h3>
                        <input type="text" id="new-srv-name" placeholder="Xizmat nomi (masalan: ChatGPT Plus)" class="w-full liquid-input rounded-2xl px-3.5 py-2.5 text-xs">
                        <input type="text" id="new-srv-desc" placeholder="Qisqacha izoh (ixtiyoriy)" class="w-full liquid-input rounded-2xl px-3.5 py-2.5 text-xs">
                        <input type="number" id="new-srv-price" placeholder="Narxi (so'mda)" class="w-full liquid-input rounded-2xl px-3.5 py-2.5 text-xs">
                        <button onclick="addNewService()" class="w-full py-3 liquid-btn-emerald text-xs font-semibold rounded-2xl">Qo'shish</button>
                    </div>
                    <div id="admin-services-list" class="space-y-2"></div>
                </div>

                <!-- 3. Rekvizitlar -->
                <div id="admin-content-requisites" class="hidden space-y-4">
                    <div class="liquid-glass p-4 space-y-3">
                        <h3 class="text-xs font-bold text-white uppercase tracking-wider">To'lov Rekviziti Qo'shish</h3>
                        <input type="text" id="req-bank" placeholder="Bank nomi (Uzcard / Humo)" class="w-full liquid-input rounded-2xl px-3.5 py-2.5 text-xs">
                        <input type="text" id="req-card" placeholder="Karta raqami (5614 ...)" class="w-full liquid-input rounded-2xl px-3.5 py-2.5 text-xs">
                        <input type="text" id="req-holder" placeholder="Karta egasi" class="w-full liquid-input rounded-2xl px-3.5 py-2.5 text-xs">
                        <button onclick="addRequisite()" class="w-full py-3 liquid-btn-emerald text-xs font-semibold rounded-2xl">Saqlash</button>
                    </div>
                    <div id="admin-requisites-list" class="space-y-2"></div>
                </div>

                <!-- 4. Sozlamalar -->
                <div id="admin-content-settings" class="hidden space-y-4">
                    <div class="liquid-glass p-4 space-y-2 text-xs">
                        <h3 class="font-bold text-white uppercase tracking-wider">Telegram Bot Holati</h3>
                        <p class="text-soft-white">Admin ID: <span class="font-mono font-bold text-white">8415531693</span></p>
                        <p class="text-soft-white">API integratsiya: <span class="text-emerald-300 font-semibold">Faol (To'g'ridan-to'g'ri yuborish)</span></p>
                    </div>
                    <div class="liquid-glass p-4 space-y-3">
                        <h3 class="text-xs font-bold text-white uppercase tracking-wider">PIN-Kodni O'zgartirish</h3>
