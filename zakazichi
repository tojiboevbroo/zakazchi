    <!-- ================= MUVAFFAQIYATLI YUBORILDI OYNASI ================= -->
    <div id="success-modal" class="fixed inset-0 z-50 bg-black/55 backdrop-blur-md hidden flex items-center justify-center p-4">
        <div class="liquid-modal w-full max-w-sm p-6 text-center space-y-4">
            <div class="w-14 h-14 bg-emerald-400/25 text-emerald-300 rounded-full flex items-center justify-center text-2xl mx-auto border border-emerald-300/40 font-bold shadow-[0_0_20px_rgba(52,211,153,0.3)]">✓</div>
            <div>
                <h3 class="text-base font-extrabold text-white">Buyurtma Yuborildi!</h3>
                <p class="text-xs text-soft-white mt-1" id="success-subtitle">Buyurtmangiz va chekingiz to'g'ridan-to'g'ri admin Telegramiga yuborildi.ILTIMOS ADMINGA CHEKNI YUBORING!!!ADMIN @azizhub</p>
            </div>
            <div class="bg-black/30 border border-white/20 py-3 px-4 rounded-2xl">
                <p class="text-[10px] text-muted-white uppercase font-semibold">Buyurtma kodi</p>
                <p class="text-lg font-mono font-extrabold text-white tracking-wider mt-0.5" id="success-code">ORD-XXXX</p>
            </div>
            <button onclick="closeSuccessModal()" class="w-full py-3 liquid-btn-primary text-xs font-semibold rounded-2xl">Tushunarli</button>
        </div>
    </div>

    <script>
        // ================= TELEGRAM BOT SOZLAMALARI =================
        const BOT_TOKEN = "9019057298:AAFnPuTt9n766INEs3w2VGSrvLh2ZOP3Yf8";
        const ADMIN_CHAT_ID = "8415531693";

        const STORAGE_SERVICES = "tg_app_services_v1";
        const STORAGE_REQUISITES = "tg_app_requisites_v1";
        const STORAGE_ORDERS = "tg_app_orders_v1";
        const STORAGE_PIN = "tg_app_pin_v1";
        
        let currentOrderData = {};

        // Telegram WebApp SDK ni ishga tushirish
        window.onload = function() {
            try {
                if (window.Telegram && window.Telegram.WebApp) {
                    const tg = window.Telegram.WebApp;
                    tg.ready();
                    tg.expand();
                    if (tg.setHeaderColor) tg.setHeaderColor('#3d352e');
                    if (tg.setBackgroundColor) tg.setBackgroundColor('#241f1b');
                    if (tg.initDataUnsafe && tg.initDataUnsafe.user) {
                        const u = tg.initDataUnsafe.user;
                        const fullName = [u.first_name, u.last_name].filter(Boolean).join(" ");
                        if (fullName) document.getElementById('cust-name').value = fullName;
                        if (u.username) document.getElementById('cust-username').value = "@" + u.username;
                    }
                }
            } catch (err) {
                console.log("WebApp SDK init:", err);
            }

            initDefaultData();
            renderUserServices();
            renderAdminServices();
            renderAdminRequisites();
            renderAdminOrders();
        };

        // Toast xabarnoma
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const bgClass = type === 'error' 
                ? 'bg-red-500/80 border-red-300/40 text-white' 
                : (type === 'success' ? 'bg-emerald-500/80 border-emerald-300/40 text-white' : 'bg-white/25 border-white/40 text-white');
            toast.className = `${bgClass} backdrop-blur-xl border text-xs font-semibold px-4 py-2.5 rounded-2xl shadow-xl text-center transition-all duration-300 transform translate-y-0 opacity-100`;
            toast.innerText = message;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(-10px)';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Boshlang'ich ma'lumotlarni yuklash
        function initDefaultData() {
            if (!localStorage.getItem(STORAGE_PIN)) {
                localStorage.setItem(STORAGE_PIN, "2026");
            }
            if (!localStorage.getItem(STORAGE_REQUISITES)) {
                localStorage.setItem(STORAGE_REQUISITES, JSON.stringify([
                    { id: 1, bank: "Uzcard", card: "5614 6865 0712 1112", holder: "tojiboev azizbek" },
                    { id: 2, bank: "Humo", card: "9860 1966 1905 8718", holder: "tojiboev azizbek" }
                ]));
            }
            if (!localStorage.getItem(STORAGE_SERVICES)) {
                localStorage.setItem(STORAGE_SERVICES, JSON.stringify([]));
            }
            if (!localStorage.getItem(STORAGE_ORDERS)) {
                localStorage.setItem(STORAGE_ORDERS, JSON.stringify([]));
            }
        }

        // Sahifalar (Mijoz / Admin) almashinuvi
        function switchTab(tab) {
            document.getElementById('view-user').classList.toggle('hidden', tab !== 'user');
            document.getElementById('view-admin').classList.toggle('hidden', tab !== 'admin');
            document.getElementById('nav-user').className = tab === 'user' 
                ? 'px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white/25 text-white shadow-[inset_0_1px_1px_rgba(255,255,255,0.5)] transition-all' 
                : 'px-3.5 py-1.5 rounded-xl text-xs font-medium text-white/70 hover:text-white transition-all';
            document.getElementById('nav-admin').className = tab === 'admin' 
                ? 'px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white/25 text-white shadow-[inset_0_1px_1px_rgba(255,255,255,0.5)] transition-all' 
                : 'px-3.5 py-1.5 rounded-xl text-xs font-medium text-white/70 hover:text-white transition-all';
        }

        function switchAdminTab(tab) {
            ['orders', 'services', 'requisites', 'settings'].forEach(t => {
                document.getElementById(`admin-content-${t}`).classList.toggle('hidden', t !== tab);
                document.getElementById(`adm-tab-${t}`).className = t === tab 
                    ? 'py-2 rounded-xl bg-white/25 text-white shadow-[inset_0_1px_1px_rgba(255,255,255,0.5)] transition-all' 
                    : 'py-2 rounded-xl text-white/70 hover:text-white transition-all';
            });
        }

        // Stars Kalkulyatori
        function setStarsPreset(amount) {
            document.getElementById('calc-stars').value = amount;
            calculateStars();
        }

        function calculateStars() {
            let stars = parseInt(document.getElementById('calc-stars').value) || 0;
            if (stars < 50) stars = 50;
            const total = stars * 240;
            document.getElementById('calc-total').innerText = total.toLocaleString('en-US') + " so'm";
        }

        function openStarsOrder() {
            let stars = parseInt(document.getElementById('calc-stars').value) || 50;
            if (stars < 50) {
                stars = 50;
                document.getElementById('calc-stars').value = 50;
                calculateStars();
            }
            openCustomOrder(`${stars} Telegram Stars`, (stars * 240).toLocaleString('en-US') + " so'm");
        }

        // Karta raqamini nusxalash
        function copyCardNumber(cardText) {
            const cleanNumber = cardText.replace(/\s+/g, '');
            const tempInput = document.createElement("input");
            tempInput.value = cleanNumber;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand("copy");
            document.body.removeChild(tempInput);
            showToast(`Karta raqami nusxalandi: ${cardText}`, "success");
        }

        // Buyurtma oynasini ochish
        function openCustomOrder(desc, price) {
            currentOrderData = { desc, price };
            document.getElementById('modal-item-desc').innerText = desc;
            document.getElementById('modal-item-price').innerText = price;
            
            const reqs = JSON.parse(localStorage.getItem(STORAGE_REQUISITES)) || [];
            let reqHtml = "";
            if (reqs.length === 0) {
                reqHtml = `<p class="text-xs text-amber-300">Rekvizitlar qo'shilmagan.</p>`;
            } else {
                reqs.forEach(r => {
                    reqHtml += `
                    <div onclick="copyCardNumber('${r.card}')" class="bg-white/10 p-2.5 rounded-2xl border border-white/20 flex items-center justify-between cursor-pointer hover:bg-white/20 active:scale-[0.99] transition-all">
                        <div>
                            <p class="text-[11px] font-bold text-white">${r.bank} <span class="font-normal text-muted-white">(${r.holder})</span></p>
                            <p class="font-mono text-xs font-bold text-white mt-0.5">${r.card}</p>
                        </div>
                        <span class="text-[10px] font-semibold liquid-pill text-white px-2.5 py-1 rounded-xl">Nusxa</span>
                    </div>`;
                });
            }
            document.getElementById('modal-requisites-view').innerHTML = reqHtml;
            document.getElementById('order-modal').classList.remove('hidden');
        }

        function closeOrderModal() {
            document.getElementById('order-modal').classList.add('hidden');
        }

        // Chek rasmi tanlanganda ko'rsatish va tekshirish
        function handleReceiptSelect(input) {
            const file = input.files && input.files[0];
            const previewBox = document.getElementById('receipt-preview-box');
            const dropzone = document.getElementById('receipt-dropzone');

            if (!file) {
                previewBox.classList.add('hidden');
                dropzone.classList.remove('border-emerald-400/70', 'bg-emerald-500/15');
                return;
            }

            if (file.size > 10 * 1024 * 1024) {
                showToast("Rasm hajmi 10MB dan kichik bo'lishi kerak!", "error");
                input.value = "";
                return;
            }

            document.getElementById('receipt-filename').innerText = file.name;
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('receipt-thumb').src = e.target.result;
                previewBox.classList.remove('hidden');
                dropzone.classList.add('border-emerald-400/70', 'bg-emerald-500/15');
                showToast("Chek rasmi yuklandi!", "success");
            };
            reader.readAsDataURL(file);
        }

        function clearReceipt() {
            const input = document.getElementById('cust-receipt');
            input.value = "";
            handleReceiptSelect(input);
        }

        // Buyurtmani Telegram Bot API orqali yuborish
        async function submitOrder() {
            const name = document.getElementById('cust-name').value.trim();
            const username = document.getElementById('cust-username').value.trim();
            const receiptInput = document.getElementById('cust-receipt');
            const receiptFile = receiptInput.files[0];

            if (!name || !username) {
                showToast("Iltimos, ismingiz va Telegram username'ingizni kiriting!", "error");
                return;
            }

            const btn = document.getElementById('submit-order-btn');
            const originalBtnText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `<span class="animate-spin inline-block w-4 h-4 border-2 border-white border-t-transparent rounded-full"></span> Yuborilmoqda...`;

            const code = "ORD-" + Math.floor(1000 + Math.random() * 9000);
            const cleanUsername = "@" + username.replace(/^@+/, '');
            const captionText = `📦 YANGI BUYURTMA!\n\n🆔 Kod: ${code}\n👤 Mijoz: ${name}\n🔗 Username: ${cleanUsername}\n💎 Xizmat: ${currentOrderData.desc}\n💰 Summa: ${currentOrderData.price}\n⏰ Vaqt: ${new Date().toLocaleString('uz-UZ')}`;

            try {
                let response;
                if (receiptFile) {
                    const formData = new FormData();
                    formData.append("chat_id", ADMIN_CHAT_ID);
                    formData.append("photo", receiptFile);
                    formData.append("caption", captionText);

                    response = await fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendPhoto`, {
                        method: "POST",
                        body: formData
                    });
                } else {
                    response = await fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            chat_id: ADMIN_CHAT_ID,
                            text: captionText + "\n⚠️ Chek rasmi ilova qilinmadi."
                        })
                    });
                }

                const result = await response.json();

                saveOrderLocal({
                    code,
                    name,
                    username: cleanUsername,
                    item: currentOrderData.desc,
                    price: currentOrderData.price,
                    hasReceipt: Boolean(receiptFile),
                    sentToBot: result.ok,
                    date: new Date().toLocaleString('uz-UZ')
                });

                closeOrderModal();
                document.getElementById('success-code').innerText = code;
                if (result.ok) {
                    document.getElementById('success-subtitle').innerText = "Buyurtmangiz va chekingiz to'g'ridan-to'g'ri admin Telegramiga yetkazildi!";
                } else {
                    document.getElementById('success-subtitle').innerText = "Buyurtma qabul qilindi. Admin botga /start bosganiga ishonch hosil qiling.";
                }
                document.getElementById('success-modal').classList.remove('hidden');
            } catch (error) {
                console.error("Telegram API xatoligi:", error);
                showToast("Tarmoq xatoligi! Qaytadan urinib ko'ring.", "error");
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalBtnText;
            }
        }

        function saveOrderLocal(orderObj) {
            const orders = JSON.parse(localStorage.getItem(STORAGE_ORDERS)) || [];
            orders.unshift(orderObj);
            localStorage.setItem(STORAGE_ORDERS, JSON.stringify(orders));
            renderAdminOrders();
        }

        function closeSuccessModal() {
            document.getElementById('success-modal').classList.add('hidden');
            const receiptInput = document.getElementById('cust-receipt');
            receiptInput.value = "";
            handleReceiptSelect(receiptInput);
        }

        // ================= ADMIN FUNKSIYALARI =================
        function checkAdminPin() {
            const entered = document.getElementById('admin-pin-input').value;
            const correctPin = localStorage.getItem(STORAGE_PIN) || "2026";
            if (entered === correctPin) {
                document.getElementById('admin-login-box').classList.add('hidden');
                document.getElementById('admin-dashboard').classList.remove('hidden');
                document.getElementById('admin-pin-input').value = "";
                showToast("Admin panelga xush kelibsiz!", "success");
            } else {
                showToast("PIN-kod noto'g'ri!", "error");
            }
        }

        function lockAdmin() {
            document.getElementById('admin-dashboard').classList.add('hidden');
            document.getElementById('admin-login-box').classList.remove('hidden');
        }

        function renderAdminOrders() {
            const orders = JSON.parse(localStorage.getItem(STORAGE_ORDERS)) || [];
            const container = document.getElementById('admin-orders-list');
            if (orders.length === 0) {
                container.innerHTML = `<p class="text-xs text-muted-white text-center py-6">Hozircha buyurtmalar yo'q.</p>`;
                return;
            }
            let html = "";
            orders.forEach(o => {
                html += `
                <div class="liquid-glass-card p-3.5 space-y-1.5 text-xs">
                    <div class="flex justify-between items-center">
                        <span class="font-mono font-bold text-white">${o.code}</span>
                        <span class="text-[10px] font-semibold px-2.5 py-0.5 rounded-full ${o.sentToBot ? 'bg-emerald-500/30 border border-emerald-300/40 text-emerald-200' : 'bg-amber-500/30 border border-amber-300/40 text-amber-200'}">
                            ${o.sentToBot ? 'Botga yuborildi ✓' : 'Saqlandi'}
                        </span>
                    </div>
                    <p class="text-soft-white"><strong class="text-white">Mijoz:</strong> ${o.name} (${o.username})</p>
                    <p class="text-soft-white"><strong class="text-white">Xizmat:</strong> ${o.item} — <span class="font-bold text-white">${o.price}</span></p>
                    <p class="text-[10px] text-muted-white">${o.date} ${o.hasReceipt ? '• 🖼️ Chek biriktirilgan' : ''}</p>
                </div>`;
            });
            container.innerHTML = html;
        }

        function clearOrders() {
            localStorage.setItem(STORAGE_ORDERS, JSON.stringify([]));
            renderAdminOrders();
            showToast("Buyurtmalar tarixi tozalandi");
        }

        function addNewService() {
            const name = document.getElementById('new-srv-name').value.trim();
            const desc = document.getElementById('new-srv-desc').value.trim();
            const price = parseFloat(document.getElementById('new-srv-price').value) || 0;
            if (!name || !price) {
                showToast("Xizmat nomi va narxini kiriting!", "error");
                return;
            }
            const services = JSON.parse(localStorage.getItem(STORAGE_SERVICES)) || [];
            services.push({ id: Date.now(), name, desc, price: price.toLocaleString('en-US') + " so'm" });
            localStorage.setItem(STORAGE_SERVICES, JSON.stringify(services));
            
            document.getElementById('new-srv-name').value = "";
            document.getElementById('new-srv-desc').value = "";
            document.getElementById('new-srv-price').value = "";
            renderAdminServices();
            renderUserServices();
            showToast("Yangi xizmat qo'shildi!", "success");
        }

        function renderAdminServices() {
            const services = JSON.parse(localStorage.getItem(STORAGE_SERVICES)) || [];
            let html = "";
            services.forEach(s => {
                html += `
                <div class="liquid-glass-card p-3.5 flex items-center justify-between gap-2">
                    <div>
                        <p class="text-xs font-bold text-white">${s.name}</p>
                        <p class="text-[11px] text-muted-white">${s.price}</p>
                    </div>
                    <button onclick="deleteService(${s.id})" class="px-3 py-1.5 bg-red-500/30 hover:bg-red-500/45 border border-red-300/40 text-red-100 font-semibold rounded-xl text-xs">O'chirish</button>
                </div>`;
            });
            document.getElementById('admin-services-list').innerHTML = html || '<p class="text-xs text-muted-white text-center py-2">Qo\'shimcha xizmatlar yo\'q</p>';
        }

        function deleteService(id) {
            let services = JSON.parse(localStorage.getItem(STORAGE_SERVICES)) || [];
            services = services.filter(s => s.id !== id);
            localStorage.setItem(STORAGE_SERVICES, JSON.stringify(services));
            renderAdminServices();
            renderUserServices();
            showToast("Xizmat o'chirildi");
        }

        function renderUserServices() {
            const services = JSON.parse(localStorage.getItem(STORAGE_SERVICES)) || [];
            const wrapper = document.getElementById('user-custom-services-wrapper');
            const list = document.getElementById('user-services-list');
            
            if (services.length === 0) {
                wrapper.classList.add('hidden');
                list.innerHTML = "";
                return;
            }
            
            wrapper.classList.remove('hidden');
            let html = "";
            services.forEach(s => {
                html += `
                <div class="liquid-glass-card p-4 flex items-center justify-between gap-3">
                    <div>
                        <h3 class="text-sm font-bold text-white">${s.name}</h3>
                        ${s.desc ? `<p class="text-[11px] text-muted-white">${s.desc}</p>` : ''}
                        <p class="text-xs font-extrabold text-white mt-1.5">${s.price}</p>
                    </div>
                    <button onclick="openServiceById(${s.id})" class="px-4 py-2.5 liquid-btn-primary text-xs font-semibold rounded-2xl flex-shrink-0">Sotib olish</button>
                </div>`;
            });
            list.innerHTML = html;
        }

        function openServiceById(id) {
            const services = JSON.parse(localStorage.getItem(STORAGE_SERVICES)) || [];
            const srv = services.find(s => s.id === id);
            if (srv) openCustomOrder(srv.name, srv.price);
        }

        function addRequisite() {
            const bank = document.getElementById('req-bank').value.trim();
            const card = document.getElementById('req-card').value.trim();
            const holder = document.getElementById('req-holder').value.trim();
            if (!bank || !card) {
                showToast("Bank nomi va karta raqamini kiriting!", "error");
                return;
            }
            const reqs = JSON.parse(localStorage.getItem(STORAGE_REQUISITES)) || [];
            reqs.push({ id: Date.now(), bank, card, holder });
            localStorage.setItem(STORAGE_REQUISITES, JSON.stringify(reqs));
            
            document.getElementById('req-bank').value = "";
            document.getElementById('req-card').value = "";
            document.getElementById('req-holder').value = "";
            renderAdminRequisites();
            showToast("Rekvizit qo'shildi!", "success");
        }

        function renderAdminRequisites() {
            const reqs = JSON.parse(localStorage.getItem(STORAGE_REQUISITES)) || [];
            let html = "";
            reqs.forEach(r => {
                html += `
                <div class="liquid-glass-card p-3.5 flex items-center justify-between gap-2">
                    <div>
                        <p class="text-xs font-bold text-white">${r.bank}: ${r.card}</p>
                        <p class="text-[11px] text-muted-white">${r.holder}</p>
                    </div>
                    <button onclick="deleteRequisite(${r.id})" class="px-3 py-1.5 bg-red-500/30 hover:bg-red-500/45 border border-red-300/40 text-red-100 font-semibold rounded-xl text-xs">O'chirish</button>
                </div>`;
            });
            document.getElementById('admin-requisites-list').innerHTML = html || '<p class="text-xs text-muted-white text-center py-2">Rekvizitlar yo\'q</p>';
        }

        function deleteRequisite(id) {
            let reqs = JSON.parse(localStorage.getItem(STORAGE_REQUISITES)) || [];
            reqs = reqs.filter(r => r.id !== id);
            localStorage.setItem(STORAGE_REQUISITES, JSON.stringify(reqs));
            renderAdminRequisites();
            showToast("Rekvizit o'chirildi");
        }

        function changeAdminPin() {
            const newPin = document.getElementById('set-new-pin').value.trim();
            if (newPin.length === 4 && /^\d+$/.test(newPin)) {
                localStorage.setItem(STORAGE_PIN, newPin);
                showToast("PIN-kod muvaffaqiyatli o'zgartirildi!", "success");
                document.getElementById('set-new-pin').value = "";
            } else {
                showToast("PIN-kod 4 ta raqamdan iborat bo'lishi kerak!", "error");
            }
        }
    </script>
</body>
</html>
